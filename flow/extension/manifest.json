{
  "manifest_version": 3,
  "name": "Flow Skill Bridge",
  "version": "0.1.0",
  "description": "Scriptable Google Flow helper for prompt + image video generation.",
  "permissions": ["activeTab", "storage", "downloads", "debugger"],
  "host_permissions": [
    "https://flow.google/*",
    "https://labs.google/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google/*",
        "https://labs.google/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Skill Bridge",
    "default_popup": "popup.html"
  }
}
